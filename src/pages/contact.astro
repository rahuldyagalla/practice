---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base title="Contact" description="Request a free IT audit or a quote for your school or college in Hyderabad.">
  <section class="band">
    <div class="wrap">
      <h1>Request a free IT audit</h1>
      <p class="muted">Call <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a> or email <a href={`mailto:${site.email}`}>{site.email}</a>, or send the form below.</p>
      <form action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value={site.formKey} />
        <input type="hidden" name="subject" value="New enquiry from website" />
        <label>Your name <input name="name" required /></label>
        <label>Institution name <input name="institution" required /></label>
        <label>Institution type
          <select name="type"><option>School</option><option>College</option><option>Training institute</option><option>Other</option></select>
        </label>
        <label>Approximate number of computers <input name="computers" type="number" min="1" /></label>
        <label>Phone <input name="phone" type="tel" required /></label>
        <label>What do you need help with? <textarea name="message" rows="4"></textarea></label>
        <button class="btn" type="submit">Send request</button>
      </form>
    </div>
  </section>
</Base>
